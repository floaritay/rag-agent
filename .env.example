SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=sk-REPLACE_ME
CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# 思考模式：流式输出模型推理过程（前端可折叠展示）；false 关闭
CHAT_THINKING=true
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
APP_HOST=127.0.0.1
APP_PORT=8000

# —— 可选：按服务覆盖地址/密钥（多供应商或分离鉴权时使用）——
# 留空/注释即回退上面共享的 SILICONFLOW_BASE_URL / SILICONFLOW_API_KEY。
# 地址需为 OpenAI 兼容端点；重排地址需兼容 SiliconFlow /rerank 协议。
# 也可在网页右上角 ⚙ 设置里分别配置三类模型（写回本文件）。
# CHAT_BASE_URL=
# CHAT_API_KEY=
# EMBED_BASE_URL=
# EMBED_API_KEY=
# RERANK_BASE_URL=
# RERANK_API_KEY=

# —— 图片通道（DeepSeek-OCR 文字化入库，默认开启）——
# OCR 三件套独立于对话通道（chat 可换供应商）；地址/密钥留空回退共享 SILICONFLOW_*。
# 默认 DeepSeek-OCR（官方 grounding 调用形态，见 ingest/ocr.py）；也可换 Qwen-VL 等。
IMAGE_DESCRIBE=true
# IMAGE_MAX_PER_DOC=20   # 单文档图片索引上限（<=0 不限）；单图 >15MB 自动跳过索引
# IMAGE_ATTACH_MAX=4    # 回答时随消息附给对话模型的图片上限（<=0 不限）
# OCR_MODEL=deepseek-ai/DeepSeek-OCR
# OCR_BASE_URL=
# OCR_API_KEY=

# —— 扫描件 PDF 解析（MinerU 云，版面+OCR+公式+表格+抽图）——
# 密钥即开关：缺省时扫描件 PDF 不做文字提取（入库报告有指引 warning）。
# MinerU=sk-REPLACE_ME
# MINERU_BASE_URL=            # 留空 = 官方云 https://mineru.net/api/v4（v4 兼容私有部署）
